# Google Cloud Console → API credentials
# Vyplň tyto hodnoty a přejmenuj soubor na .env.local

# ID tvé veřejné Google Drive složky (z URL: drive.google.com/drive/folders/TOTO_JE_ID)
# Složka musí být nastavena na "Kdokoli se odkazem může zobrazit"
VITE_PUBLIC_FOLDER_ID=10v3FidrkqL9ZkK4aE8eM5aBWyL8FZc8l

# Google Cloud Console → Credentials
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your_api_key

# Drive file ID souboru _index.json (vyplnit po prvním přihlášení — viz banner v aplikaci)
VITE_INDEX_FILE_ID=
